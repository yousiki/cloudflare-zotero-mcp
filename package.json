{
  "name": "zotero-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server for Zotero libraries synced with WebDAV file storage, running on Cloudflare Workers",
  "// private": "Not an npm package — you deploy this Worker, you do not install it. Guards against an accidental publish; unrelated to the MIT license below.",
  "private": true,
  "license": "MIT",
  "author": "yousiki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yousiki/zotero-mcp.git"
  },
  "homepage": "https://github.com/yousiki/zotero-mcp#readme",
  "bugs": "https://github.com/yousiki/zotero-mcp/issues",
  "keywords": [
    "zotero",
    "mcp",
    "model-context-protocol",
    "webdav",
    "cloudflare-workers",
    "reference-manager"
  ],
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bun run scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "fflate": "^0.8.2",
    "unpdf": "^1.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
